        resolvedDefaultFeatures = [ "derive" ];
      };
      "zerofrom-derive" = rec {
        crateName = "zerofrom-derive";
        version = "0.1.8";
        edition = "2021";
        sha256 = "0jhdy4p9c6ja3dynsdck14g2iilq8ai5ch6nsi455x67ys1lcnzp";
        procMacro = true;
        libName = "zerofrom_derive";
        authors = [
