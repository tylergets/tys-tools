      };
      "zerotrie" = rec {
        crateName = "zerotrie";
        version = "0.2.5";
        edition = "2021";
        sha256 = "0gss16krjzk22m57dz5hkdjg99ibj6pa41qr68na7w1jpp1nk8jf";
        authors = [
          "The ICU4X Project Developers"
